# ============================================================
# Aliyun Guard — 环境变量
# 复制此文件为 .env 后修改
# ============================================================

# 时区
TZ=Asia/Shanghai

# Web 面板绑定 IP（0.0.0.0 = 允许公网访问，127.0.0.1 = 仅本机）
ALIYUN_GUARD_BIND_IP=0.0.0.0

# Web 面板端口
ALIYUN_GUARD_WEB_PORT=8765

# 公网 IPv4（留空则容器自动探测；探测失败时手动填写）
ALIYUN_GUARD_PUBLIC_IP=
